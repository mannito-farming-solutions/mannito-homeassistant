{
  "config": {
    "step": {
      "user": {
        "title": "Connect a Mannito board",
        "description": "Create an API token on the page of your board in the Mannito cloud (card \"API-Zugänge\"). A token belongs to exactly one board.",
        "data": {
          "url": "Cloud address",
          "api_token": "API token"
        },
        "data_description": {
          "url": "Address of the Mannito cloud. Keep the suggested address unless you run a cloud of your own.",
          "api_token": "The token starting with mnt_. Its rights (read, control, configure) decide which entities appear."
        }
      },
      "reauth_confirm": {
        "title": "New API token for {name}",
        "description": "The token of {name} no longer works (revoked or expired). Create a new token for this board in the Mannito cloud.",
        "data": {
          "api_token": "API token"
        },
        "data_description": {
          "api_token": "The token starting with mnt_. Its rights (read, control, configure) decide which entities appear."
        }
      },
      "reconfigure": {
        "title": "Change cloud address or token",
        "description": "The token must belong to the same board. A new token replaces the old one, which is then revoked in the Mannito cloud.",
        "data": {
          "url": "Cloud address",
          "api_token": "API token"
        },
        "data_description": {
          "url": "Address of the Mannito cloud. Keep the suggested address unless you run a cloud of your own.",
          "api_token": "The token starting with mnt_. Its rights (read, control, configure) decide which entities appear."
        }
      }
    },
    "error": {
      "cannot_connect": "The Mannito cloud could not be reached.",
      "invalid_auth": "The token is unknown, revoked or expired.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This board is already set up.",
      "reauth_successful": "The new token works.",
      "reconfigure_successful": "The settings were changed.",
      "wrong_board": "The token belongs to another board."
    }
  },
